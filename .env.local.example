# Laravel csg-api origin.
CSG_API_BASE_URL=http://localhost:8000

# Microsoft Entra / MSAL browser authentication.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000/login
NEXT_PUBLIC_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# Optional additional scopes, space-separated. OpenID basics are always included.
NEXT_PUBLIC_ENTRA_SCOPES=

# Local development only. When true, bypasses Microsoft login and uses a stub user.
NEXT_PUBLIC_AUTH_BYPASS=false

# Optional. Defaults to this value when unset.
CSG_API_STAGE_ONE_PREFIX=/api/v1/procurement-services/stage-one

# Configure to match Laravel middleware.
# CSG_API_TOKEN is sent as Authorization: Bearer <token>.
CSG_API_TOKEN=

# CSG_API_KEY is sent as X-API-Key.
CSG_API_KEY=

# Optional dashboard pin.
RECONCILIATION_DASHBOARD_RUN_ID=
