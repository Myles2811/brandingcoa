# Microsoft Graph app-only authentication
GRAPH_TENANT_ID=38c0960d-93be-4501-997d-b4ef907a2d8e
GRAPH_CLIENT_ID=dacca82c-5f1c-41fa-b903-dd966e63c09b
GRAPH_CLIENT_SECRET=PASTE_REAL_SECRET_HERE

# Temporary local alternative to client-secret authentication. Leave blank when using app credentials.
GRAPH_BEARER_TOKEN=
# One-off delegated administrator token for the site-grant script only. Prefer supplying it in the shell.
GRAPH_ADMIN_BEARER_TOKEN=

# SharePoint site and document library
SHAREPOINT_HOSTNAME=neogenixltd.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/REBATES-TEST
# Optional: leave blank to resolve from hostname/path and workbook item IDs.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Workbook drive-item IDs
REBATE_CHECK_LOG_ITEM_ID=01SX5GCXBMPRKAFDZIRRC3KUD5YREJ2H3H
INVOICE_SPREADSHEET_ITEM_ID=01SX5GCXFCD3XT5OILRNFI5IKMZ6KNNSVP
FRAMEWORK_RULES_ITEM_ID=01SX5GCXFXJBWHIL372JEI2PBVES3IBNOQ

# Required by POST /api/reconciliation/sync and /api/reconciliation/run.
# Generate a long random value; send it as Authorization: Bearer <value> or X-API-Key.
RECONCILIATION_API_KEY=PASTE_LONG_RANDOM_API_KEY_HERE

# Embeddings-only entity-resolution hard gate (0 to 1).
RECONCILIATION_ENTITY_THRESHOLD=0.72
